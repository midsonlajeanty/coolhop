#!/usr/bin/env bash
set -euo pipefail

usage="usage: bin/dump-schema <postgres-container> | --upstream <coolify-version>"
root="$(cd "$(dirname "$0")/.." && pwd)"
out="${root}/tests/fixtures/schema.sql"
references="${root}/app/Schema/ReferenceColumns.php"

dump() {
  {
    docker exec "$1" pg_dump -U postgres -d coolify --schema-only --no-owner --no-privileges --no-comments
    docker exec "$1" pg_dump -U postgres -d coolify --data-only --no-owner -t public.migrations --inserts
  } | grep -vE '^(\\restrict|\\unrestrict|--)' | cat -s > "$out"
  echo "wrote $out"

  {
    printf '<?php\n\ndeclare(strict_types=1);\n\nnamespace App\\Schema;\n\nfinal class ReferenceColumns\n{\n    public const array ALL = [\n'
    docker exec "$1" psql -U postgres -d coolify -Atc \
      "select table_name || '.' || column_name from information_schema.columns where table_schema = 'public' and (column_name like '%\\_id' or column_name like '%\\_type') order by 1" \
      | sed "s/.*/        '&',/"
    printf '    ];\n}\n'
  } > "$references"
  echo "wrote $references"
}

upstream() {
  local version="${1#v}" suffix="$$"
  local network="coolhop-upstream-${suffix}" pg="coolhop-upstream-pg-${suffix}"
  trap 'docker rm -f "'"$pg"'" > /dev/null 2>&1 || true; docker network rm "'"$network"'" > /dev/null 2>&1 || true' EXIT

  docker network create "$network" > /dev/null
  docker run -d --name "$pg" --network "$network" -e POSTGRES_PASSWORD=x -e POSTGRES_DB=coolify postgres:15 > /dev/null
  until docker exec "$pg" pg_isready -U postgres -d coolify > /dev/null 2>&1; do sleep 1; done
  sleep 2

  docker run --rm --network "$network" --entrypoint php \
    -e DB_CONNECTION=pgsql -e DB_HOST="$pg" -e DB_PORT=5432 -e DB_DATABASE=coolify \
    -e DB_USERNAME=postgres -e DB_PASSWORD=x \
    -e APP_KEY="base64:$(head -c 32 /dev/urandom | base64)" \
    "coollabsio/coolify:${version}" artisan migrate --force --no-interaction

  dump "$pg"
}

case "${1:-}" in
  --upstream) upstream "${2:?$usage}" ;;
  "") echo "$usage" >&2; exit 2 ;;
  *) dump "$1" ;;
esac
